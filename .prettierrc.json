{
    "plugins": ["prettier-plugin-java"],
    "tabWidth": 4,
    "printWidth": 150,
    "overrides": [
        {
            "files": "*.java",
            "options": {
                "parser": "java"
            }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
